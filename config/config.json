{
  "detection": {
    "backends": ["retinaface", "mediapipe", "mtcnn", "opencv"],
    "similarity_threshold": 0.40,
    "face_confidence_min": 0.6,
    "identity_confirmation": {
      "enabled": true,
      "min_confirmations": 1,
      "min_confidence_for_confirmation": 0.6,
      "min_live_score_for_confirmation": 0.5
    },
    "auto_exit": {
      "enabled": true,
      "min_confidence": 0.5,
      "exit_delay_seconds": 1.0
    }
  },
  "performance": {
    "detection_size": [320, 240],
    "display_size": [640, 480],
    "frame_skip": 3,
    "queue_size": 2,
    "camera_fps": 30
  },
  "smoothing": {
    "window_size": 5,
    "min_votes": 3,
    "region_quantization": 10
  },
  "display": {
    "show_fps": true,
    "show_backend": true,
    "show_processing_time": true,
    "font_scale": 0.6,
    "line_thickness": 2
  },
  "anti_spoofing": {
    "enabled": false,
    "mode": "adaptive",
    "eye_aspect_ratio_threshold": 0.15,
    "blink_frames_threshold": 2,
    "motion_threshold": 3.0,
    "texture_variance_threshold": 40,
    "edge_density_threshold": 0.02,
    "color_variance_threshold": 100,
    "confidence_boost_real_face": 0.25,
    "lighting_compensation": {
      "enabled": true,
      "min_brightness": 10,
      "max_brightness": 250,
      "adjust_thresholds": true,
      "low_light_texture_factor": 0.3,
      "bright_light_texture_factor": 0.8,
      "brightness_variance_threshold": 40
    }
  },
  "incremental_learning": {
    "enabled": true,
    "update_cooldown": 5.0,
    "min_confidence": 0.8,
    "min_liveness_score": 0.7,
    "update_frequency": 5,
    "max_embeddings_per_person": 20,
    "outlier_threshold": 0.3,
    "weighted_alpha": 0.8,
    "drift_detection_threshold": 0.4,
    "embedding_variance_threshold": 0.1,
    "enable_auto_backup": true,
    "mismatch_detection_enabled": true
  }
}
