{
  "detection": {
    "backends": ["retinaface", "mediapipe", "mtcnn", "opencv"],
    "similarity_threshold": 0.35,
    "face_confidence_min": 0.7,
    "max_faces": 2
  },
  "performance": {
    "detection_size": [320, 240],
    "display_size": [640, 480],
    "frame_skip": 3,
    "queue_size": 2,
    "camera_fps": 30
  },
  "smoothing": {
    "window_size": 7,
    "min_votes": 4,
    "region_quantization": 10
  },
  "display": {
    "show_fps": true,
    "show_backend": true,
    "show_processing_time": true,
    "font_scale": 0.6,
    "line_thickness": 2
  },
  "anti_spoofing": {
    "enabled": true,
    "texture_variance_threshold": 100,
    "edge_density_threshold": 0.05,
    "color_variance_threshold": 200,
    "motion_threshold": 5.0
  },
  "incremental_learning": {
    "enabled": true,
    "update_cooldown": 5.0,
    "min_confidence": 0.8,
    "update_frequency": 5,
    "max_embeddings_per_person": 20,
    "outlier_threshold": 0.3,
    "weighted_alpha": 0.8
  }
}
